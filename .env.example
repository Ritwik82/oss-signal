# OSS Signal — environment variables

# GitHub token for the data refresh script (scripts/refresh-data.mjs).
# Classic token, no scopes needed for public repos.
# Also set this as a repo secret named GITHUB_TOKEN for the GitHub Actions workflow.
GITHUB_TOKEN=

# Optional: Vercel KV credentials for the /api/tracked PUT endpoint.
# The app works read-only without these.
# KV_API_URL=
# KV_API_TOKEN=
# KV_READ_ONLY_API_TOKEN=
